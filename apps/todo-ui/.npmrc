# Dependencies resolve through the Harbor npm proxy cache project, not npmjs.org
# directly. Harbor pulls from upstream on a miss and caches the tarball.
registry=https://8gcr.container-registry.dev/npm/todomvc-npm/
always-auth=true

# Credentials are injected in CI, never committed:
#   //8gcr.container-registry.dev/npm/todomvc-npm/:_auth=<base64 of "user:password">
# Harbor honours Basic auth via _auth only. _authToken (Bearer) is rejected by the
# backend even though the Harbor portal's "Usage" tab suggests it.
