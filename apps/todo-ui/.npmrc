# Every package resolves through the todomvc-npm project: Harbor serves what it
# holds (including this app, once published) and fetches the rest from npmjs.org.
registry=https://demo.container-registry.com/npm/todomvc-npm/

# CI appends the credential, never committed:
#   //demo.container-registry.com/npm/todomvc-npm/:_auth=<base64 of "jwt:<token>">
# Harbor reads HTTP Basic from _auth. _authToken (Bearer) is not accepted.
