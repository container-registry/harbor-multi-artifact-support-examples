<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.12</version>
    <relativePath/>
  </parent>

  <groupId>com.containerregistry.todo</groupId>
  <artifactId>todo-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>todo-api</name>

  <properties>
    <java.version>21</java.version>
    <harbor.registry>8gcr.container-registry.dev</harbor.registry>
    <harbor.maven.project>todomvc-maven</harbor.maven.project>
    <!-- Full base URL, overridable as one unit so a plain-HTTP local dev
         instance works: -Dharbor.url=http://localhost:8080 -->
    <harbor.url>https://${harbor.registry}</harbor.url>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Publishing target. No <repositories> block on purpose: resolution is redirected
       by the mirrorOf=* entry in .mvn/settings.xml, which also covers plugin repositories. -->
  <distributionManagement>
    <repository>
      <id>8gcr</id>
      <name>8gcr Maven</name>
      <url>${harbor.url}/maven/${harbor.maven.project}</url>
    </repository>
  </distributionManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
