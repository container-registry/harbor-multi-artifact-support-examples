<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fallback settings: same <server> credentials as settings.xml, but no mirror, so
  dependencies come straight from Maven Central.

  Used when the registry's Maven endpoint is not reachable. Keeping the <server> entry
  means `mvn deploy` still authenticates correctly against distributionManagement even
  though resolution bypasses the registry.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <servers>
    <server>
      <id>8gcr</id>
      <username>${env.HARBOR_USERNAME}</username>
      <password>${env.HARBOR_PASSWORD}</password>
    </server>
  </servers>
</settings>
