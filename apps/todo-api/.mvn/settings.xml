<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <mirrors>
    <!-- mirrorOf=* instead of "central": a <repositories> block in the pom only redirects
         dependency resolution, while plugins and their transitive dependencies keep coming
         from the built-in central plugin repository. The wildcard mirror is the only place
         that catches both, so every byte of the build passes through the Harbor proxy cache. -->
    <mirror>
      <id>8gcr</id>
      <name>8gcr Maven proxy cache</name>
      <mirrorOf>*</mirrorOf>
      <url>https://8gcr.container-registry.dev/maven/todomvc-maven</url>
    </mirror>
  </mirrors>

  <servers>
    <!-- Same id as the mirror above AND as distributionManagement/repository in pom.xml,
         so this one entry authenticates both pull and push. -->
    <server>
      <id>8gcr</id>
      <username>${env.HARBOR_USERNAME}</username>
      <password>${env.HARBOR_PASSWORD}</password>
    </server>
  </servers>

</settings>
