[0.224, "o", "\r\n\u001b[2m# An intranet machine: Homebrew's hosts resolve to nowhere, only Harbor is reachable.\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mfor h in $BLOCKED; do [ \"$h\" = --add-host ] || echo \"blocked: ${h%:*}\"; done\u001b[0m\r\n"]
[0.609, "o", "blocked: formulae.brew.sh\r\nblocked: ghcr.io\r\nblocked: pkg-containers.githubusercontent.com\r\n"]
[0.000, "o", "blocked: github.com\r\n"]
[0.000, "o", "blocked: api.github.com\r\nblocked: raw.githubusercontent.com\r\n"]
[0.000, "o", "blocked: objects.githubusercontent.com\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mdocker run --rm --platform linux/amd64 $BLOCKED $IMG bash -c \"for u in https://formulae.brew.sh https://ghcr.io $H; do curl -s -m5 -o /dev/null \\$u && echo reachable: \\$u || echo unreachable: \\$u; done\"\u001b[0m\r\n"]
[1.164, "o", "unreachable: https://formulae.brew.sh\r\n"]
[0.086, "o", "unreachable: https://ghcr.io\r\n"]
[0.387, "o", "reachable: https://8gcr.container-registry.dev\r\n"]
[0.272, "o", "\r\n\u001b[2m# The client gets five settings, all pointing at one Harbor project (robot secret masked here).\u001b[0m\r\n"]
[1.000, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37msed -E \"s#//[^@]*@#//<robot>@#; s/(TOKEN=).*/\\1<robot>/\" $BREW_ENV\u001b[0m\r\n"]
[0.611, "o", "HOMEBREW_API_DOMAIN=https://<robot>@8gcr.container-registry.dev/homebrew/brew-priv/api\r\nHOMEBREW_ARTIFACT_DOMAIN=https://8gcr.container-registry.dev/homebrew/brew-priv\r\nHOMEBREW_ARTIFACT_DOMAIN_NO_FALLBACK=1\r\nHOMEBREW_DOCKER_REGISTRY_BASIC_AUTH_TOKEN=<robot>\r\nHOMEBREW_NO_AUTO_UPDATE=1\r\n"]
[0.001, "o", "\r\n\u001b[2m# brew install jq: formula metadata, manifests and bottles all come from Harbor.\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mdocker run --rm --platform linux/amd64 $BLOCKED --env-file $BREW_ENV $IMG bash -c \"set -o pipefail; brew install jq 2>&1 | grep -E 'Downloading|Pouring|🍺' && jq --version\"\u001b[0m\r\n"]
[26.051, "o", "==> Downloading https://8gcr.container-registry.dev/homebrew/brew-priv/v2/homebrew/core/jq/manifests/1.8.2-1\r\n==> Downloading https://8gcr.container-registry.dev/homebrew/brew-priv/v2/homebrew/core/oniguruma/manifests/6.9.10\r\n==> Downloading https://8gcr.container-registry.dev/homebrew/brew-priv/v2/homebrew/core/oniguruma/blobs/sha256:49eb885ab9a80ce30edc0aaa5f531fc0079a17e5cf41c2b6c34be0e53e763993\r\n==> Downloading https://8gcr.container-registry.dev/homebrew/brew-priv/v2/homebrew/core/jq/blobs/sha256:631787d9b19df5e5557cc83f972080e541f543f8df2d1f212ca4290ff23e9764\r\n==> Downloading https://8gcr.container-registry.dev/homebrew/brew-priv/v2/homebrew/core/oniguruma/manifests/6.9.10\r\n==> Pouring oniguruma--6.9.10.x86_64_linux.bottle.tar.gz\r\n🍺  /home/linuxbrew/.linuxbrew/Cellar/oniguruma/6.9.10: 16 files, 1.7MB\r\n==> Pouring jq--1.8.2.x86_64_linux.bottle.1.tar.gz\r\n🍺  /home/linuxbrew/.linuxbrew/Cellar/jq/1.8.2: 21 files, 1.5MB\r\n"]
[0.027, "o", "jq-1.8.2\r\n"]
[1.311, "o", "\r\n\u001b[2m# Harbor side: cached bottles are artifacts, every pull is audited under the robot's name.\u001b[0m\r\n"]
[1.006, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mcurl -s -K $CURLRC \"$H/api/v2.0/projects/brew-priv/repositories\" | jq -r \".[] | [.name, .artifact_count, .pull_count] | @tsv\"\u001b[0m\r\n"]
[0.955, "o", "brew-priv/homebrew/core/ripgrep\t1\t2\r\nbrew-priv/homebrew/core/pcre2\t1\t2\r\nbrew-priv/homebrew/core/bzip2\t1\t2\r\nbrew-priv/homebrew/core/zlib-ng-compat\t1\t2\r\nbrew-priv/homebrew/core/oniguruma\t1\t21\r\nbrew-priv/homebrew/core/jq\t2\t33\r\n"]
[0.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mcurl -s -K $CURLRC \"$H/api/v2.0/auditlog-exts?page_size=4&q=resource%3D~brew-priv\" | jq -r \".[] | [.op_time, .username, .operation, .resource] | @tsv\"\u001b[0m\r\n"]
