{"version":3,"term":{"cols":100,"rows":30},"timestamp":1788160055,"idle_time_limit":2.0,"command":"bash /tmp/claude-1000/-var-home-bupd-code-harbor--worktrees-8gcr-multi-project/b878d917-0729-4da8-9e1c-e74a38bd2c2b/scratchpad/demos/04-homebrew.sh","env":{"SHELL":"/bin/bash"}}
[0.005, "o", "\r\n\u001b[2m# Homebrew: formula metadata AND bottles through one proxy project.\u001b[0m\r\n"]
[1.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mcurl -su admin:Harbor12345 -X POST -H \"Content-Type: application/json\" http://localhost:8080/api/v2.0/registries -d \"{\\\"name\\\":\\\"brew-sh\\\",\\\"type\\\":\\\"homebrew\\\",\\\"url\\\":\\\"https://formulae.brew.sh/api\\\"}\" -w \"endpoint: %{http_code}\\n\"\u001b[0m\r\n"]
[0.962, "o", "endpoint: 201\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mRID=$(curl -su admin:Harbor12345 \"http://localhost:8080/api/v2.0/registries?q=name%3Dbrew-sh\" | jq \".[0].id\"); curl -su admin:Harbor12345 -X POST -H \"Content-Type: application/json\" http://localhost:8080/api/v2.0/projects -d \"{\\\"project_name\\\":\\\"brew-demo\\\",\\\"registry_id\\\":$RID,\\\"metadata\\\":{\\\"public\\\":\\\"true\\\"}}\" -w \"project: %{http_code}\\n\"\u001b[0m\r\n"]
[0.790, "o", "project: 201\r\n"]
[0.001, "o", "\r\n\u001b[2m# Formula metadata comes from formulae.brew.sh via the /api path.\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mcurl -su admin:Harbor12345 http://localhost:8080/homebrew/brew-demo/api/formula/jq.json | jq \"{name: .name, version: .versions.stable}\"\u001b[0m\r\n"]
[0.920, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"jq\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"version\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"1.8.2\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.001, "o", "\r\n\u001b[2m# brew asks for the version manifest, then the platform bottle it names.\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mcurl -su admin:Harbor12345 -H \"Accept: application/vnd.oci.image.index.v1+json\" http://localhost:8080/homebrew/brew-demo/v2/homebrew/core/jq/manifests/1.8.1 -o /tmp/jq-idx.json -w \"manifest: %{http_code}\\n\"\u001b[0m\r\n"]
[1.499, "o", "manifest: 200\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mDG=$(jq -r \".manifests[].annotations | select(.\\\"org.opencontainers.image.ref.name\\\" | endswith(\\\"x86_64_linux\\\")) | .\\\"sh.brew.bottle.digest\\\"\" /tmp/jq-idx.json); echo \"bottle digest: $DG\"\u001b[0m\r\n"]
[0.604, "o", "bottle digest: 82883e1f3b674759d0e3d0c37e6805c0f91e3886f3e40c7ebc57f1e0174dfbe7\r\n"]
[0.000, "o", "\r\n\u001b[2m# Cold pull round-trips to ghcr.io; the warm pull serves from Harbor.\u001b[0m\r\n"]
[1.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mcurl -su admin:Harbor12345 -o /tmp/jq1.tgz -w \"cold: %{http_code} %{size_download} bytes %{time_total}s\\n\" http://localhost:8080/homebrew/brew-demo/v2/homebrew/core/jq/blobs/sha256:$DG\u001b[0m\r\n"]
[1.709, "o", "cold: 200 494577 bytes 1.101346s\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mcurl -su admin:Harbor12345 -o /tmp/jq2.tgz -w \"warm: %{http_code} %{size_download} bytes %{time_total}s\\n\" http://localhost:8080/homebrew/brew-demo/v2/homebrew/core/jq/blobs/sha256:$DG\u001b[0m\r\n"]
[0.709, "o", "warm: 200 494577 bytes 0.102061s\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mcmp /tmp/jq1.tgz /tmp/jq2.tgz && sha256sum /tmp/jq2.tgz | cut -c1-20\u001b[0m\r\n"]
[0.620, "o", "82883e1f3b674759d0e3\r\n"]
[0.000, "o", "\r\n\u001b[2m# The cached bottle is a real artifact: repository, quota, audit log.\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37msleep 3; curl -su admin:Harbor12345 \"http://localhost:8080/api/v2.0/projects/brew-demo/repositories\" | jq -r \".[] | [.name, (.pull_count|tostring)] | @tsv\"\u001b[0m\r\n"]
[3.691, "o", "brew-demo/homebrew/core/jq\t2\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mcurl -su admin:Harbor12345 \"http://localhost:8080/api/v2.0/auditlog-exts?page_size=3\" | jq -r \".[] | [.op_time, .operation, .resource] | @tsv\"\u001b[0m\r\n"]
[0.690, "o", "2026-08-31T07:07:46.936Z\tpull\tbrew-demo/homebrew/core/jq:1.8.1\r\n2026-08-31T07:07:46.420Z\tpull\tbrew-demo/homebrew/core/jq:1.8.1\r\n2026-08-31T07:07:38.488Z\tcreate\tbrew-demo\r\n"]
[0.001, "x", "0"]
