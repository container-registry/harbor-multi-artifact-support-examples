{"version":3,"term":{"cols":100,"rows":30},"timestamp":1788159955,"idle_time_limit":2.0,"command":"bash /tmp/claude-1000/-var-home-bupd-code-harbor--worktrees-8gcr-multi-project/b878d917-0729-4da8-9e1c-e74a38bd2c2b/scratchpad/demos/01-npm.sh","env":{"SHELL":"/bin/bash"}}
[0.005, "o", "\r\n\u001b[2m# One npm registry URL: resolves upstream packages through the proxy AND hosts our own.\u001b[0m\r\n"]
[1.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mauth=$(printf \"admin:Harbor12345\" | base64 | tr -d \"\\n\"); printf \"//localhost:8080/npm/todomvc-npm/:_auth=%s\\n\" \"$auth\" > /tmp/harbor-npmrc\u001b[0m\r\n"]
[0.604, "o", "\r\n\u001b[2m# The packument comes from upstream - full version list, even on a cold cache.\u001b[0m\r\n"]
[1.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mcurl -su admin:Harbor12345 $H/npm/todomvc-npm/lodash | jq \"{versions: (.versions|length), latest: .\\\"dist-tags\\\".latest}\"\u001b[0m\r\n"]
[0.738, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"versions\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39m117\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"latest\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"4.18.1\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.000, "o", "\r\n\u001b[2m# Exact pins of never-cached versions pull through.\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mnpm install lodash@4.17.21 --userconfig /tmp/harbor-npmrc --registry=$REG --cache $(mktemp -d) --prefix $(mktemp -d) 2>&1 | tail -1\u001b[0m\r\n"]
[1.265, "o", "added 1 package in 608ms\r\n"]
[0.000, "o", "\r\n\u001b[2m# Install the app dependencies through the proxy, then build.\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mrm -rf node_modules && npm ci --userconfig /tmp/harbor-npmrc --registry=$REG --cache $(mktemp -d) 2>&1 | tail -1\u001b[0m\r\n"]
[3.708, "o", "npm notice\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mnpm run build 2>&1 | tail -3\u001b[0m\r\n"]
[1.317, "o", "dist/assets/index-IFVnNuV8.css   7.16 kB │ gzip:  2.26 kB\r\ndist/assets/index-KnMSoJwm.js   71.54 kB │ gzip: 28.34 kB\r\n✓ built in 435ms\r\n"]
[0.000, "o", "\r\n\u001b[2m# Publish our own package into the same project.\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mV=0.1.$(date +%Y%m%d%H%M%S); npm version $V --no-git-tag-version\u001b[0m\r\n"]
[0.666, "o", "\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mUnknown project config \"always-auth\". This will stop working in the next major version of npm. See `npm help npmrc` for supported config options.\u001b[39m\r\n"]
[0.022, "o", "v0.1.20260831123608\r\n"]
[0.004, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mnpm publish --userconfig /tmp/harbor-npmrc --registry=$REG 2>&1 | tail -1\u001b[0m\r\n"]
[2.788, "o", "+ todomvc-todo-ui@0.1.20260831123608\r\n"]
[0.000, "o", "\r\n\u001b[2m# Prove it: cold pull-back of the version we just published.\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mnpm pack todomvc-todo-ui@$V --userconfig /tmp/harbor-npmrc --registry=$REG --cache $(mktemp -d) --pack-destination $(mktemp -d) 2>&1 | tail -1\u001b[0m\r\n"]
[1.095, "o", "todomvc-todo-ui-0.1.20260831123608.tgz\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mgit restore package.json package-lock.json\u001b[0m\r\n"]
[0.606, "x", "0"]
