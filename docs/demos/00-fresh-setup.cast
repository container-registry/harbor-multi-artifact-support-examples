{"version":3,"term":{"cols":100,"rows":30},"timestamp":1788159925,"idle_time_limit":2.0,"command":"bash /tmp/claude-1000/-var-home-bupd-code-harbor--worktrees-8gcr-multi-project/b878d917-0729-4da8-9e1c-e74a38bd2c2b/scratchpad/demos/00-fresh-setup.sh","env":{"SHELL":"/bin/bash"}}
[0.005, "o", "\r\n\u001b[2m# A fresh Harbor Next dev instance: backend containers with hot reload.\u001b[0m\r\n"]
[1.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mexport DEV_CONTAINER_USER=root COMPOSE_PROJECT_NAME=harbor-0 HOST_GOMODCACHE=$(go env GOMODCACHE) HOST_GOCACHE=$(go env GOCACHE)\u001b[0m\r\n"]
[0.607, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mdocker compose -f devenv/docker-compose.yml --env-file versions.env --profile core --profile jobservice --profile registryctl up -d --build 2>&1 | tail -8\u001b[0m\r\n"]
[3.521, "o", "fbd552d26ad3c36faf48cdc4c04fd0f25f127ec50e561d3767f715e3b766c9d3\r\nce0f794f447ffe1925b6683904ef990b808d616c8b6b835174074792a5b5a446\r\nharbor-0_postgresql_1\r\nharbor-0_redis_1\r\nharbor-0_registry_1\r\nharbor-0_registryctl_1\r\nharbor-0_core_1\r\nharbor-0_jobservice_1\r\n"]
[0.001, "o", "\r\n\u001b[2m# Wait for core to answer (first boot compiles Harbor inside the container).\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37muntil curl -sf -o /dev/null http://localhost:8080/api/v2.0/ping; do sleep 5; printf .; done; echo \" core is up\"\u001b[0m\r\n"]
[0.609, "o", " core is up\r\n"]
[0.000, "o", "\r\n\u001b[2m# Multi-format endpoints sit behind a commercial feature gate - enable once.\u001b[0m\r\n"]
[1.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mcurl -su admin:Harbor12345 -X PUT -H \"Content-Type: application/json\" http://localhost:8080/api/v2.0/configurations -d \"{\\\"enable_commercial_multi_format_artifacts\\\": true}\" -w \"%{http_code}\\n\"\u001b[0m\r\n"]
[0.690, "o", "200\r\n"]
[0.001, "o", "\r\n\u001b[2m# Provision registry endpoints and projects with the repo script.\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mHARBOR_URL=http://localhost:8080 HARBOR_PASS=Harbor12345 SKIP_WIF=1 ./scripts/setup-8gcr.sh 2>&1 | tail -15\u001b[0m\r\n"]
[1.803, "o", "    \u001b[32m✓\u001b[0m npm -> registry.npmjs.org created\r\n    \u001b[32m✓\u001b[0m maven -> repo1.maven.org created\r\n    \u001b[32m✓\u001b[0m npmjs verified (type=npm)\r\n    \u001b[32m✓\u001b[0m maven-central verified (type=maven)\r\n    \u001b[32m✓\u001b[0m npm endpoint id=1, maven endpoint id=2\r\n\r\n\u001b[1m==> Projects\u001b[0m\r\n    \u001b[32m✓\u001b[0m project todomvc-npm created\r\n    \u001b[32m✓\u001b[0m todomvc-npm verified (proxy cache -> registry 1, publishing allowed)\r\n    \u001b[32m✓\u001b[0m project todomvc-maven created\r\n    \u001b[32m✓\u001b[0m todomvc-maven verified (proxy cache -> registry 2, publishing allowed)\r\n    \u001b[32m✓\u001b[0m project todomvc (OCI images) created\r\n\r\n\u001b[1m==> SKIP_WIF=1 - skipping federated identity provider and robot\u001b[0m\r\n    \u001b[32m✓\u001b[0m registries and projects provisioned\r\n"]
[0.001, "o", "\r\n\u001b[2m# What we have now:\u001b[0m\r\n"]
[1.001, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mcurl -su admin:Harbor12345 \"http://localhost:8080/api/v2.0/projects?page_size=20\" | jq -r \".[] | [.name, (.registry_id // 0 | tostring)] | @tsv\"\u001b[0m\r\n"]
[0.695, "o", "library\t0\r\ntodomvc\t0\r\ntodomvc-maven\t2\r\ntodomvc-npm\t1\r\n"]
