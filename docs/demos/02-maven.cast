[0.000, "o", "\r\n\u001b[2m# Deploy a release version into the same project.\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mV=0.1.$(date +%Y%m%d%H%M%S); mvn -B -q -s .mvn/settings-local.xml versions:set -DnewVersion=$V -DgenerateBackupPoms=false\u001b[0m\r\n"]
