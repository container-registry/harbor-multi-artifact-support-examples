[9.109, "o", "\u001b[0m\u001b[0m"]
[0.011, "o", "\u001b[1;32m$\u001b[0m \u001b[1;37mmvn -B -q -s .mvn/settings-local.xml deploy -DskipTests -Dharbor.url=http://localhost:8080 && echo DEPLOYED $V\u001b[0m\r\n"]
