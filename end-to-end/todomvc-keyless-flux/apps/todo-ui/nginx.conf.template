server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The bundle calls /api on its own origin, so the browser never needs to reach the API directly.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
