# Dependencies resolve through the read-only npmjs proxy project. The @todomvc
# scope, which this app publishes under, lives in the hosted todomvc-npm project.
registry=https://demo.container-registry.com/npm/npmjs/
@todomvc:registry=https://demo.container-registry.com/npm/todomvc-npm/

# CI appends the credential for the hosted project, never committed:
#   //demo.container-registry.com/npm/todomvc-npm/:_auth=<base64 of "jwt:<token>">
# Harbor reads HTTP Basic from _auth. _authToken (Bearer) is not accepted.
